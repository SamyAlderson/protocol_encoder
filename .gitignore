# .gitignore
# ignore node_modules and yarn.lock
node_modules/
yarn.lock

# ignore rust artifacts
target/

# ignore IDE files
.idea/
.vscode/

# ignore other stuff
.DS_Store
Thumbs.db
ehthumbs.db
ehcache.db
.sass-cache/
.sass-cache-v2/
.sourcemaps/
.cache/
dist/

# ignore some other stuff
*.log
*.tmp
*.swp
*.bak
*.orig
*.rej
*.rej.orig
*.tmporig
*.tmprej

# ignore some other stuff
*.pyc
*.pyo
*.class
*.o
*.obj
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.manifest
*.spec
*.swo
*.stw
*.egg-info/
dist/
build/
env/
venv/
__pycache__/
*.egg
*.whl
*.dist-info/
*.egg-info/
*.pyc
*.pyo
*.class

# ignore some other stuff
*.rbc
*.rbs
*.rbx
*.rbw
*.rbg
*.rbm
*.rbx
*.rbw
*.rbg
*.rbm

