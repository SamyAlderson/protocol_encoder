# .gitignore
# ignore node_modules and yarn.lock
node_modules/
yarn.lock

# ignore rust project files
target/
Cargo.lock
Cargo.toml.lock

# ignore IDE files
.idea/
.vscode/

# ignore other files
.DS_Store
Thumbs.db
ehthumbs.db
*.log
*.tmp
*.swp
*.suo
*.ntvs*
*.sln.docstates
